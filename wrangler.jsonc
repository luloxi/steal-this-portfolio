{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steal-this-portfolio",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "steal-this-portfolio"
    }
  ],
  // Cloudflare D1: blog_posts, project_overrides and the Better Auth tables.
  // Secrets (wrangler secret put, never in this file): BETTER_AUTH_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET. Locally they go in .dev.vars.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steal-this-portfolio",
      "database_id": "07f92fbd-f365-4770-b253-30aa1c1af997",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare R2: images uploaded from the blog editor (served at /media/...).
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "lulox-media" }
  ],
  // Custom domains. lulox.com.ar is canonical (www 301s to apex in worker.ts).
  // lulox.dev + www are NOT served by this Worker: they are 301'd to lulox.com.ar by a Redirect Rule on that zone.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "lulox.com.ar", "custom_domain": true },
    { "pattern": "www.lulox.com.ar", "custom_domain": true }
  ],
  // Contact form: Email Routing send binding (lulox.com.ar, verified destination).
  // Fallback only (used when RESEND_API_KEY is not set); it can only deliver to this verified address.
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "lucianoolivabianco@gmail.com" }
  ],
  "ratelimits": [
    { "name": "CONTACT_RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Referral code availability check (/api/referrals/check), typed live with a debounce.
    { "name": "REF_CHECK_RL", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // TURNSTILE_SECRET is a Worker secret (never in this file).
  "vars": {
    "CONTACT_TO": "hola@lulox.com.ar",
    "CONTACT_FROM": "no-responder@lulox.com.ar",
    // With RESEND_API_KEY set: the owner's copy goes here and the visitor gets a confirmation.
    "CONTACT_INBOX": "hola@lulox.com.ar",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFYS_U1JH5j5qo8w"
  },
  "observability": {
    "enabled": true
  }
}
